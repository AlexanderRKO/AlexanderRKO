# Xero OAuth 2.0 Configuration
# Copy this file to .env and fill in your Xero app credentials

# Required: Xero App Credentials
# Get these from https://developer.xero.com/app/manage
XERO_CLIENT_ID=your_client_id_here
XERO_CLIENT_SECRET=your_client_secret_here

# Optional: OAuth Redirect URI
# Default: http://localhost:8080/callback
# For web dashboard: http://localhost:5000/xero/callback
XERO_REDIRECT_URI=http://localhost:8080/callback

# Optional: OAuth Scopes (space-separated)
# Default scopes provide read-only access to accounting data
# See docs/XERO_INTEGRATION.md for available scopes
# XERO_SCOPES=openid profile email offline_access accounting.transactions.read accounting.contacts.read

# Optional: Token Encryption Key
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If not set, tokens are stored in plain text (not recommended for production)
# XERO_TOKEN_ENCRYPTION_KEY=your_fernet_key_here

# Optional: Token Storage Path
# Default: ./data/xero_tokens.db
# XERO_TOKEN_STORAGE_PATH=/path/to/xero_tokens.db

# Optional: API Settings
# XERO_RATE_LIMIT_DELAY=0.5
# XERO_MAX_RETRIES=3
# XERO_REQUEST_TIMEOUT=30
